# Sample account file for GContactsSync.
#
# Copy this to the phone as gcontactssync.txt, in any of:
#
#     E:\gcontactssync.txt        memory card root      <- the easy one over USB
#     E:\Data\gcontactssync.txt
#     F:\gcontactssync.txt        mass memory, on the phones that have it
#     F:\Data\gcontactssync.txt
#     C:\Data\gcontactssync.txt   phone memory
#
# Then tap "load from file" on the main page. The app reads the first one it finds.
#
# Two lines are all that is read. The separator may be ':' or '=', spacing and key case do not
# matter, and '#' or ';' starts a comment.
#
# The password is a Google App Password, 16 characters, from
# https://myaccount.google.com/apppasswords - NOT the account's own password. Google shows it as
# four groups of four; copying it with the spaces in is fine, they are stripped.
#
# The app only ever READS this file. Delete it once the account is entered: there is no reason to
# leave an App Password on the memory card, where any application can read it.

login: someone@gmail.com
password: abcdefghijklmnop
